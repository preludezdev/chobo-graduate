<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 앱을 열 때 잠깐 보이는 화면: 뒷유리(어두운 바탕)에 붙은 '초보운전' 딱지와 이름. 차에서는 짧게 지나갑니다. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:windowSplashScreenBackground">@color/glass</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/splash_brand</item>
    </style>
    <color name="page">#0B0F14</color>
    <color name="glass">#0B0F14</color>
</resources>
